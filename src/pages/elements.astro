---
import DocsLayout from "../layouts/DocsLayout.astro";
import catalog from "../../docs/elements/catalog.json";
import specimens from "../../docs/elements/specimens.json";

const platforms = ["Web", "macOS"] as const;
const entriesForPlatform = (platform: (typeof platforms)[number]) =>
  catalog.elements.filter((element) => element.platform === platform);
const slugify = (value: string) =>
  value.toLowerCase().replaceAll(" ", "-").replaceAll("&", "and");
---

<DocsLayout
  title="UI element library"
  description="A visual draft design system for all 81 interface entries, with styled examples and platform-aware guidance for web and macOS."
  eyebrow="Interface reference"
>
  <div class="rule-callout">
    <div>
      <strong>Visual examples for all 81 entries</strong>
      <p>Every example is shown at reading size. Interactive controls update within the sample, and the larger view gives you more room to inspect it. Definitions and guidance stay below.</p>
    </div>
  </div>

  <nav class="platform-index" aria-label="Catalog platforms">
    <a href="#web">Web entries <span>{entriesForPlatform("Web").length}</span></a>
    <a href="#macos">macOS entries <span>{entriesForPlatform("macOS").length}</span></a>
  </nav>

  <p class="catalog-note">The examples use the draft VINASIG palette, Space Grotesk, restrained surfaces, and shared spacing. Use web entries for website work. macOS samples are platform references. Their web adaptations are included only where the underlying need has a reasonable web equivalent.</p>

  {platforms.map((platform) => {
    const platformEntries = entriesForPlatform(platform);
    const platformId = platform === "Web" ? "web" : "macos";
    const platformCategories = catalog.categories.filter((category) => category.platform === platform);

    return (
      <section class="page-section catalog-platform" id={platformId} aria-labelledby={platformId + "-title"}>
        <div class="section-heading">
          <div>
            <p class="section-kicker">{platformEntries.length} entries</p>
            <h2 id={platformId + "-title"}>{platform === "Web" ? "Web interface patterns" : "macOS interface patterns"}</h2>
          </div>
          <p>{platform === "Web" ? "Use these entries to identify common website structures, controls, and states." : "Use these entries to recognize native macOS concepts. Do not reproduce desktop chrome in a website without a clear product need."}</p>
        </div>

        {platformCategories.map((category) => {
          const categoryEntries = platformEntries.filter((element) => element.category === category.name);
          const categoryId = platformId + "-" + slugify(category.name);

          return (
            <section class="element-category" aria-labelledby={categoryId + "-title"}>
              <div class="element-category-heading">
                <h3 id={categoryId + "-title"}>{category.name}</h3>
                <span>{categoryEntries.length}</span>
              </div>
              <div class="element-list">
                {categoryEntries.map((element) => {
                  const specimen = (specimens as Record<string, string>)[element.id];

                  return (
                    <article class="element-entry" id={element.id}>
                      <header class="element-entry-heading">
                        <span class="element-order">{String(element.order).padStart(2, "0")}</span>
                        <span class="element-name">
                          <strong>{element.name}</strong>
                          <small>{element.id}</small>
                        </span>
                        <button class="element-expand-button" type="button" data-open-demo>Open larger view</button>
                      </header>
                      <div class="element-preview" aria-label={element.name + " example"}>
                        <div class="ui-sample" data-specimen-id={element.id} set:html={specimen}></div>
                      </div>
                      <details class="element-notes">
                        <summary>Definition and implementation guidance</summary>
                        <div class="element-content">
                          <p>{element.definition}</p>
                        <div class="element-guidance">
                          <div>
                            <h4>Implementation guidance</h4>
                            <p>{element.guidance}</p>
                          </div>
                          <div>
                            <h4>Accessibility</h4>
                            <p>{element.accessibility}</p>
                          </div>
                          {element.webGuidance && (
                            <div class="web-adaptation">
                              <h4>Web adaptation</h4>
                              <p>{element.webGuidance}</p>
                            </div>
                          )}
                        </div>
                        </div>
                      </details>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </section>
    );
  })}
  <dialog class="element-demo-dialog" aria-labelledby="element-demo-title">
    <div class="element-demo-heading">
      <div>
        <p class="eyebrow">Interactive example</p>
        <h2 id="element-demo-title"></h2>
      </div>
      <button type="button" class="element-expand-button" data-close-demo>Close preview</button>
    </div>
    <p class="element-demo-description"></p>
    <div class="element-demo-stage"></div>
  </dialog>

  <script>
    import "../scripts/element-demos.ts";
  </script>

</DocsLayout>

<style is:global>
  .platform-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
    padding: 0.9rem 0;
    border-block: 1px solid var(--color-border);
  }

  .platform-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-small);
    font-weight: 600;
    text-decoration: none;
  }

  .platform-index span,
  .element-category-heading > span {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .catalog-note {
    max-width: 74ch;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .catalog-platform {
    scroll-margin-top: 1rem;
  }

  .element-category {
    margin-top: 1.5rem;
    scroll-margin-top: 1rem;
  }

  .element-category-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .element-category-heading h3 {
    margin: 0;
    font-size: var(--font-size-body);
  }

  .element-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .element-entry {
    min-width: 0;
    padding: 0.9rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .element-entry-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
  }

  .element-order {
    min-width: 1.8rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .element-name {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
    flex: 1;
  }

  .element-name strong {
    font-size: var(--font-size-body);
    font-weight: 600;
  }

  .element-expand-button {
    display: inline-flex;
    min-height: 2.25rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.65rem;
    color: var(--color-scout-blue-strong);
    background: var(--color-scout-blue-soft);
    border: 1px solid var(--color-scout-blue-border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--font-size-small);
    font-weight: 600;
    cursor: pointer;
  }

  .element-expand-button:hover {
    background: var(--color-scout-blue-border);
  }

  .element-name small {
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .element-preview {
    display: grid;
    min-height: 15rem;
    place-items: center;
    overflow: auto;
    color: var(--color-text);
    background: var(--color-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem;
  }

  .element-preview .ui-sample {
    width: 100%;
    max-width: 44rem;
    min-height: 12rem;
  }

  .element-preview .ui-sample > * {
    max-width: 100%;
  }

  .element-notes {
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .element-notes > summary {
    padding: 0.65rem 0 0.1rem;
    color: var(--color-scout-blue-strong);
    font-size: var(--font-size-small);
    font-weight: 600;
    cursor: pointer;
  }

  .element-notes > summary:focus-visible,
  .element-expand-button:focus-visible,
  .ui-sample button:focus-visible,
  .ui-sample input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .element-content {
    padding: 0.65rem 0.1rem 0.35rem;
  }

  .element-demo-dialog {
    width: min(58rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100vh - 2rem);
    padding: 1.25rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: 0 1.25rem 4rem rgb(68 58 59 / 24%);
  }

  .element-demo-dialog::backdrop {
    background: rgb(31 27 28 / 62%);
  }

  .element-demo-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .element-demo-heading .eyebrow {
    margin-bottom: 0.25rem;
  }

  .element-demo-heading h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .element-demo-description {
    max-width: 70ch;
    color: var(--color-text-muted);
  }

  .element-demo-stage {
    display: grid;
    min-height: 18rem;
    place-items: center;
    padding: 1.25rem;
    background: var(--color-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .element-demo-stage:has(.sample-multi-select-showcase) { min-height: 29rem; }
  .element-demo-stage:has(.sample-multi-select-showcase) .ui-sample { max-width: 54rem; min-height: 25rem; }

  .element-demo-stage:has(.sample-hover-card:not([hidden])) {
    min-height: 24rem;
  }

  .element-demo-stage:has(.sample-hover-card:not([hidden])) .sample-hover {
    transform: translateY(-1rem);
  }

  .element-demo-stage:has(.sample-control-trio) {
    min-height: 22rem;
  }

  .element-demo-stage .ui-sample {
    width: 100%;
    max-width: 48rem;
    min-height: 15rem;
    font-size: 1.05rem;
  }

  .element-demo-stage .ui-sample:has(.sample-parallax) {
    max-width: 40rem;
  }

  .element-demo-stage .sample-parallax-viewport {
    height: 13rem;
  }

  .element-demo-stage .ui-sample small {
    font-size: 0.82rem;
  }

  .ui-sample,
  .ui-sample * {
    box-sizing: border-box;
    font-family: "Space Grotesk", sans-serif;
  }

  .ui-sample {
    display: flex;
    width: 100%;
    min-width: 0;
    min-height: 12rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  :where(.ui-sample) button {
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
    text-align: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .ui-sample input {
    min-width: 0;
    color: inherit;
    font: inherit;
  }

  .ui-sample strong,
  .ui-sample b {
    font-weight: 600;
  }

  .ui-sample small {
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .ui-sample i[class^="fi-br-"] {
    color: var(--color-scout-blue);
    font-size: 0.95rem;
    font-style: normal;
  }

  .sample-button {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.7rem;
    color: var(--color-white);
    background: var(--color-scout-blue);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .sample-button-small {
    min-height: 1.8rem;
    padding-inline: 0.55rem;
  }

  .sample-input-line {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.55rem;
    color: var(--color-text-muted);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .sample-state {
    width: fit-content;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.82rem;
  }

  .sample-state-green {
    color: var(--color-builder-green-strong);
    background: var(--color-builder-green-soft);
  }

  .sample-state-orange {
    color: var(--color-thinker-orange-strong);
    background: var(--color-thinker-orange-soft);
  }

  .sample-state-red {
    color: var(--color-auditor-red);
    background: var(--color-auditor-red-soft);
  }

  .sample-card-blue { background: var(--color-scout-blue-soft); }
  .sample-card-orange { background: var(--color-thinker-orange-soft); }
  .sample-card-green { background: var(--color-builder-green-soft); }
  .sample-card-red { background: var(--color-auditor-red-soft); }

  .sample-data-table { width: 100%; overflow: hidden; background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .sample-data-table-scroll { width: 100%; overflow-x: auto; }
  .sample-data-table table { width: 100%; border-collapse: collapse; font-size: 0.72rem; text-align: left; }
  .sample-data-table th,
  .sample-data-table td { padding: 0.5rem 0.65rem; border-bottom: 1px solid var(--color-border); white-space: nowrap; }
  .sample-data-table th { color: var(--color-text-muted); background: var(--color-surface-muted); font-weight: 600; }
  .sample-data-table th.sample-data-select,
  .sample-data-table td:first-child { width: 2.35rem; padding-inline: 0.65rem 0.2rem; }
  .sample-data-table th[data-sort-column] button { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 0.4rem; padding: 0; color: inherit; background: transparent; border: 0; font: inherit; text-align: left; cursor: pointer; }
  .sample-data-table th[data-sort-column] button::after { color: var(--color-text-muted); content: "↕"; font-size: 0.82rem; }
  .sample-data-table th[aria-sort="ascending"] button::after { color: var(--color-scout-blue); content: "↑"; }
  .sample-data-table th[aria-sort="descending"] button::after { color: var(--color-scout-blue); content: "↓"; }
  .sample-data-table th[data-sort-column] button:hover { color: var(--color-scout-blue); }
  .sample-data-table tbody tr:nth-child(even) { background: var(--color-surface); }
  .sample-data-table tbody tr:hover { background: var(--color-surface-muted); }
  .sample-data-table tbody tr.is-selected,
  .sample-data-table tbody tr.is-selected:hover { background: var(--color-scout-blue-soft); }
  .sample-data-table td:last-child,
  .sample-data-table th:last-child { text-align: right; }
  .sample-data-table td:last-child { font-variant-numeric: tabular-nums; font-weight: 600; }
  .sample-data-table input[type="checkbox"] { width: 0.9rem; height: 0.9rem; margin: 0; accent-color: var(--color-scout-blue); vertical-align: middle; cursor: pointer; }
  .sample-data-table-footer { display: flex; min-height: 2.3rem; align-items: center; justify-content: space-between; gap: 0.65rem; padding: 0.35rem 0.65rem; color: var(--color-text-muted); background: var(--color-white); font-size: 0.66rem; }
  .sample-data-table-footer [data-table-selection] { color: var(--color-scout-blue-strong); font-weight: 600; }
  .sample-data-table-pages { display: flex; align-items: center; gap: 0.4rem; }
  .sample-data-table-pages button { min-height: 1.55rem; padding: 0.15rem 0.45rem; color: var(--color-scout-blue); background: var(--color-white); border: 1px solid var(--color-border); border-radius: 3px; font: inherit; cursor: pointer; }
  .sample-data-table-pages button:hover:not(:disabled) { background: var(--color-scout-blue-soft); }
  .sample-data-table-pages button:disabled { color: var(--color-text-muted); opacity: 0.5; cursor: default; }

  .sample-bottom-nav { display: flex; width: 100%; justify-content: space-around; padding: 0.5rem 0.2rem 0.25rem; border-top: 1px solid var(--color-border); }
  .sample-nav-item { display: grid; justify-items: center; gap: 0.2rem; color: var(--color-text-muted); }
  .sample-nav-item.is-current { color: var(--color-scout-blue); }
  .sample-nav-item small { color: inherit; }

  .sample-timeline { width: min(100%, 36rem); overflow: hidden; color: var(--color-text); background: var(--color-white); border: 1px solid var(--color-border); border-radius: 0.65rem; }
  .sample-timeline-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--color-border); }
  .sample-timeline-heading { display: grid; gap: 0.12rem; }
  .sample-timeline-heading strong { font-size: 0.9rem; }
  .sample-timeline-heading small,
  .sample-timeline-time,
  .sample-timeline-event small,
  .sample-timeline-hint { color: var(--color-text-muted); }
  .sample-timeline-heading small,
  .sample-timeline-event small { font-size: 0.75rem; }
  .sample-timeline-status { color: var(--color-scout-blue-strong); font-size: 0.75rem; font-weight: 600; text-align: right; }
  .sample-timeline-list { display: grid; margin: 0; padding: 1rem 1.1rem 0; list-style: none; }
  .sample-timeline-item { position: relative; display: grid; align-items: stretch; column-gap: 0.75rem; grid-template-columns: 4.1rem 0.9rem minmax(0, 1fr); padding-bottom: 1rem; }
  .sample-timeline-item::after { position: absolute; z-index: 0; top: 0.75rem; bottom: -0.75rem; left: calc(4.1rem + 0.75rem + 0.45rem - 1px); width: 2px; background: var(--color-border-strong); content: ""; }
  .sample-timeline-item.is-complete::after { background: var(--color-scout-blue); }
  .sample-timeline-item:last-child { padding-bottom: 0; }
  .sample-timeline-item:last-child::after { display: none; }
  .sample-timeline-time { padding-top: 0.15rem; font-size: 0.7rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .sample-timeline-marker { position: relative; z-index: 1; display: flex; justify-content: center; align-items: flex-start; }
  .sample-timeline-dot { width: 0.62rem; height: 0.62rem; flex: 0 0 auto; margin-top: 0.44rem; background: var(--color-scout-blue); border: 2px solid var(--color-scout-blue); border-radius: 50%; }
  .sample-timeline-dot-button { position: relative; display: grid; width: 2rem; height: 2rem; flex: 0 0 auto; place-items: center; margin: -0.25rem 0 0; padding: 0; background: transparent; border: 0; border-radius: 50%; cursor: pointer; }
  .sample-timeline-dot-button::before { width: 0.62rem; height: 0.62rem; background: var(--color-white); border: 2px solid var(--color-scout-blue); border-radius: 50%; box-shadow: 0 0 0 3px var(--color-scout-blue-soft); content: ""; }
  .sample-timeline-dot-button:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 1px; }
  .sample-timeline-dot-button[aria-disabled="true"] { width: 0.62rem; height: 0.62rem; margin-top: 0.44rem; cursor: default; }
  .sample-timeline-dot-button[aria-disabled="true"]::before { background: var(--color-scout-blue); box-shadow: none; }
  .sample-timeline-event { display: grid; align-content: start; gap: 0.08rem; min-width: 0; }
  .sample-timeline-event strong { font-size: 0.82rem; }
  .sample-timeline-hint { margin: 0; padding: 0.65rem 1.1rem 0.85rem; font-size: 0.68rem; }

  .sample-status { width: min(100%, 28rem); }
  .sample-status[data-presence-state="available"] { --sample-presence-color: var(--color-success-accent); }
  .sample-status[data-presence-state="away"] { --sample-presence-color: var(--color-warning-accent); }
  .sample-status[data-presence-state="busy"] { --sample-presence-color: var(--color-error-accent); }
  .sample-status[data-presence-state="offline"] { --sample-presence-color: var(--color-border-strong); }
  .sample-presence-card { overflow: hidden; color: var(--color-text); background: var(--color-white); border: 1px solid var(--color-border); border-radius: 0.7rem; }
  .sample-presence-header { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.7rem 0.9rem; color: var(--color-text-muted); border-bottom: 1px solid var(--color-border); font-size: 0.68rem; font-weight: 600; }
  .sample-presence-live { display: flex; align-items: center; gap: 0.4rem; color: var(--color-text); }
  .sample-presence-live-dot,
  .sample-presence-option-dot { width: 0.5rem; height: 0.5rem; flex: 0 0 auto; background: var(--sample-presence-color); border-radius: 50%; }
  .sample-presence-person { display: flex; align-items: center; gap: 0.8rem; padding: 0.9rem; }
  .sample-presence-avatar { position: relative; display: grid; width: 3.5rem; height: 3.5rem; flex: 0 0 auto; place-items: center; color: var(--color-scout-blue-strong); background: var(--color-scout-blue-soft); border-radius: 50%; font-size: 1rem; font-weight: 600; }
  .sample-presence-avatar-indicator { position: absolute; right: -0.08rem; bottom: -0.08rem; display: grid; width: 1rem; height: 1rem; place-items: center; background: var(--color-white); border-radius: 50%; }
  .sample-presence-avatar-indicator::before { position: absolute; inset: 0; background: var(--sample-presence-color); border-radius: 50%; content: ""; opacity: 0; }
  .sample-status[data-presence-state="available"] .sample-presence-avatar-indicator::before { animation: sample-presence-ping 1.8s ease-out infinite; }
  .sample-presence-avatar-indicator > span { position: relative; z-index: 1; width: 0.58rem; height: 0.58rem; background: var(--sample-presence-color); border: 2px solid var(--color-white); border-radius: 50%; }
  .sample-presence-identity { display: grid; min-width: 0; gap: 0.12rem; }
  .sample-presence-identity strong { font-size: 0.9rem; }
  .sample-presence-identity > span { color: var(--color-text); font-size: 0.75rem; font-weight: 600; }
  .sample-presence-identity small { color: var(--color-text-muted); font-size: 0.7rem; }
  .sample-presence-fieldset { min-width: 0; margin: 0; padding: 0.65rem 0.9rem 0.7rem; border: 0; border-top: 1px solid var(--color-border); }
  .sample-presence-fieldset legend { padding: 0; color: var(--color-text-muted); font-size: 0.68rem; font-weight: 600; }
  .sample-presence-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.4rem; }
