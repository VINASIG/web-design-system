---
import DocsLayout from "../layouts/DocsLayout.astro";
import catalog from "../../docs/elements/catalog.json";
import specimens from "../../docs/elements/specimens.json";

const platforms = ["Web", "macOS"] as const;
const entriesForPlatform = (platform: (typeof platforms)[number]) =>
  catalog.elements.filter((element) => element.platform === platform);
const slugify = (value: string) =>
  value.toLowerCase().replaceAll(" ", "-").replaceAll("&", "and");
---

<DocsLayout
  title="UI element library"
  description="A visual draft design system for all 81 interface entries, with styled examples and platform-aware guidance for web and macOS."
  eyebrow="Interface reference"
>
  <div class="rule-callout">
    <div>
      <strong>Visual examples for all 81 entries</strong>
      <p>Every example is shown at reading size. Interactive controls update within the sample, and the larger view gives you more room to inspect it. Definitions and guidance stay below.</p>
    </div>
  </div>

  <nav class="platform-index" aria-label="Catalog platforms">
    <a href="#web">Web entries <span>{entriesForPlatform("Web").length}</span></a>
    <a href="#macos">macOS entries <span>{entriesForPlatform("macOS").length}</span></a>
  </nav>

  <p class="catalog-note">The examples use the draft VINASIG palette, Space Grotesk, restrained surfaces, and shared spacing. Use web entries for website work. macOS samples are platform references. Their web adaptations are included only where the underlying need has a reasonable web equivalent.</p>

  {platforms.map((platform) => {
    const platformEntries = entriesForPlatform(platform);
    const platformId = platform === "Web" ? "web" : "macos";
    const platformCategories = catalog.categories.filter((category) => category.platform === platform);

    return (
      <section class="page-section catalog-platform" id={platformId} aria-labelledby={platformId + "-title"}>
        <div class="section-heading">
          <div>
            <p class="section-kicker">{platformEntries.length} entries</p>
            <h2 id={platformId + "-title"}>{platform === "Web" ? "Web interface patterns" : "macOS interface patterns"}</h2>
          </div>
          <p>{platform === "Web" ? "Use these entries to identify common website structures, controls, and states." : "Use these entries to recognize native macOS concepts. Do not reproduce desktop chrome in a website without a clear product need."}</p>
        </div>

        {platformCategories.map((category) => {
          const categoryEntries = platformEntries.filter((element) => element.category === category.name);
          const categoryId = platformId + "-" + slugify(category.name);

          return (
            <section class="element-category" aria-labelledby={categoryId + "-title"}>
              <div class="element-category-heading">
                <h3 id={categoryId + "-title"}>{category.name}</h3>
                <span>{categoryEntries.length}</span>
              </div>
              <div class="element-list">
                {categoryEntries.map((element) => {
                  const specimen = (specimens as Record<string, string>)[element.id];

                  return (
                    <article class="element-entry" id={element.id}>
                      <header class="element-entry-heading">
                        <span class="element-order">{String(element.order).padStart(2, "0")}</span>
                        <span class="element-name">
                          <strong>{element.name}</strong>
                          <small>{element.id}</small>
                        </span>
                        <button class="element-expand-button" type="button" data-open-demo>Open larger view</button>
                      </header>
                      <div class="element-preview" aria-label={element.name + " example"}>
                        <div class="ui-sample" data-specimen-id={element.id} set:html={specimen}></div>
                      </div>
                      <details class="element-notes">
                        <summary>Definition and implementation guidance</summary>
                        <div class="element-content">
                          <p>{element.definition}</p>
                        <div class="element-guidance">
                          <div>
                            <h4>Implementation guidance</h4>
                            <p>{element.guidance}</p>
                          </div>
                          <div>
                            <h4>Accessibility</h4>
                            <p>{element.accessibility}</p>
                          </div>
                          {element.webGuidance && (
                            <div class="web-adaptation">
                              <h4>Web adaptation</h4>
                              <p>{element.webGuidance}</p>
                            </div>
                          )}
                        </div>
                        </div>
                      </details>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </section>
    );
  })}
  <dialog class="element-demo-dialog" aria-labelledby="element-demo-title">
    <div class="element-demo-heading">
      <div>
        <p class="eyebrow">Interactive example</p>
        <h2 id="element-demo-title"></h2>
      </div>
      <button type="button" class="element-expand-button" data-close-demo>Close preview</button>
    </div>
    <p class="element-demo-description"></p>
    <div class="element-demo-stage"></div>
  </dialog>

  <script>
    import "../scripts/element-demos.ts";
  </script>

</DocsLayout>

<style is:global>
  .platform-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
    padding: 0.9rem 0;
    border-block: 1px solid var(--color-border);
  }

  .platform-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-small);
    font-weight: 600;
    text-decoration: none;
  }

  .platform-index span,
  .element-category-heading > span {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .catalog-note {
    max-width: 74ch;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .catalog-platform {
    scroll-margin-top: 1rem;
  }

  .element-category {
    margin-top: 1.5rem;
    scroll-margin-top: 1rem;
  }

  .element-category-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .element-category-heading h3 {
    margin: 0;
    font-size: var(--font-size-body);
  }

  .element-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .element-entry {
    min-width: 0;
    padding: 0.9rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .element-entry-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
  }

  .element-order {
    min-width: 1.8rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .element-name {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
    flex: 1;
  }

  .element-name strong {
    font-size: var(--font-size-body);
    font-weight: 600;
  }

  .element-expand-button {
    display: inline-flex;
    min-height: 2.25rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.65rem;
    color: var(--color-scout-blue-strong);
    background: var(--color-scout-blue-soft);
    border: 1px solid var(--color-scout-blue-border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--font-size-small);
    font-weight: 600;
    cursor: pointer;
  }

  .element-expand-button:hover {
    background: var(--color-scout-blue-border);
  }

  .element-name small {
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .element-preview {
    display: grid;
    min-height: 15rem;
    place-items: center;
    overflow: auto;
    color: var(--color-text);
    background: var(--color-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem;
  }

  .element-preview .ui-sample {
    width: 100%;
    max-width: 44rem;
    min-height: 12rem;
  }

  .element-preview .ui-sample > * {
    max-width: 100%;
  }

  .element-notes {
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .element-notes > summary {
    padding: 0.65rem 0 0.1rem;
    color: var(--color-scout-blue-strong);
    font-size: var(--font-size-small);
    font-weight: 600;
    cursor: pointer;
  }

  .element-notes > summary:focus-visible,
  .element-expand-button:focus-visible,
  .ui-sample button:focus-visible,
  .ui-sample input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .element-content {
    padding: 0.65rem 0.1rem 0.35rem;
  }

  .element-demo-dialog {
    width: min(58rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100vh - 2rem);
    padding: 1.25rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: 0 1.25rem 4rem rgb(68 58 59 / 24%);
  }

  .element-demo-dialog::backdrop {
    background: rgb(31 27 28 / 62%);
  }

  .element-demo-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .element-demo-heading .eyebrow {
    margin-bottom: 0.25rem;
  }

  .element-demo-heading h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .element-demo-description {
    max-width: 70ch;
    color: var(--color-text-muted);
  }

  .element-demo-stage {
    display: grid;
    min-height: 18rem;
    place-items: center;
    padding: 1.25rem;
    background: var(--color-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .element-demo-stage:has(.sample-hover-card:not([hidden])) {
    min-height: 24rem;
  }

  .element-demo-stage:has(.sample-hover-card:not([hidden])) .sample-hover {
    transform: translateY(-1rem);
  }

  .element-demo-stage:has(.sample-control-trio) {
    min-height: 22rem;
  }

  .element-demo-stage .ui-sample {
    width: 100%;
    max-width: 48rem;
    min-height: 15rem;
    font-size: 1.05rem;
  }

  .element-demo-stage .ui-sample:has(.sample-parallax) {
    max-width: 40rem;
  }

  .element-demo-stage .sample-parallax-viewport {
    height: 13rem;
  }

  .element-demo-stage .ui-sample small {
    font-size: 0.82rem;
  }

  .ui-sample,
  .ui-sample * {
    box-sizing: border-box;
    font-family: "Space Grotesk", sans-serif;
  }

  .ui-sample {
    display: flex;
    width: 100%;
    min-width: 0;
    min-height: 12rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  :where(.ui-sample) button {
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
    text-align: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .ui-sample input {
    min-width: 0;
    color: inherit;
    font: inherit;
  }

  .ui-sample strong,
  .ui-sample b {
    font-weight: 600;
  }

  .ui-sample small {
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .ui-sample i[class^="fi-br-"] {
    color: var(--color-scout-blue);
    font-size: 0.95rem;
    font-style: normal;
  }

  .sample-button {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.7rem;
    color: var(--color-white);
    background: var(--color-scout-blue);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .sample-button-small {
    min-height: 1.8rem;
    padding-inline: 0.55rem;
  }

  .sample-input-line {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.55rem;
    color: var(--color-text-muted);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .sample-state {
    width: fit-content;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.82rem;
  }

  .sample-state-green {
    color: var(--color-builder-green-strong);
    background: var(--color-builder-green-soft);
  }

  .sample-state-orange {
    color: var(--color-thinker-orange-strong);
    background: var(--color-thinker-orange-soft);
  }

  .sample-card-blue { background: var(--color-scout-blue-soft); }
  .sample-card-orange { background: var(--color-thinker-orange-soft); }
  .sample-card-green { background: var(--color-builder-green-soft); }
  .sample-card-red { background: var(--color-auditor-red-soft); }

  .sample-table { width: 100%; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .sample-table-row { display: grid; align-items: center; gap: 0.75rem; padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--color-border); grid-template-columns: 1.3fr 0.9fr 0.7fr; }
  .sample-table-row:last-child { border-bottom: 0; }
  .sample-table-head { color: var(--color-text-muted); background: var(--color-surface-muted); font-size: 0.72rem; font-weight: 600; }

  .sample-bottom-nav { display: flex; width: 100%; justify-content: space-around; padding: 0.5rem 0.2rem 0.25rem; border-top: 1px solid var(--color-border); }
  .sample-nav-item { display: grid; justify-items: center; gap: 0.2rem; color: var(--color-text-muted); }
  .sample-nav-item.is-current { color: var(--color-scout-blue); }
  .sample-nav-item small { color: inherit; }

  .sample-timeline { display: grid; width: 100%; gap: 0.8rem; }
  .sample-timeline > div { display: grid; align-items: start; gap: 0.65rem; grid-template-columns: 0.7rem minmax(0, 1fr); }
  .sample-timeline > div > i { width: 0.55rem; height: 0.55rem; margin-top: 0.3rem; background: var(--color-scout-blue); border: 2px solid var(--color-scout-blue-soft); border-radius: 50%; }
  .sample-timeline > div + div > i { background: var(--color-surface); border-color: var(--color-border-strong); }
  .sample-timeline span { display: grid; gap: 0.08rem; }

  .sample-status { display: flex; align-items: center; gap: 0.55rem; }
  .sample-status small { margin-left: auto; }
  .sample-dot { width: 0.55rem; height: 0.55rem; flex: 0 0 auto; border-radius: 50%; }
  .sample-dot.is-green { background: var(--color-builder-green); }

  .sample-chat { display: grid; width: 100%; justify-items: start; gap: 0.4rem; }
  .sample-bubble { max-width: 75%; padding: 0.55rem 0.75rem; background: var(--color-surface-muted); border-radius: 0.8rem 0.8rem 0.8rem 0.2rem; }
  .sample-bubble-own { justify-self: end; color: var(--color-white); background: var(--color-scout-blue); border-radius: 0.8rem 0.8rem 0.2rem 0.8rem; }
  .sample-chat > small { justify-self: end; }

  .sample-steps { display: flex; width: 100%; justify-content: space-between; }
  .sample-steps > span { position: relative; display: grid; justify-items: center; gap: 0.4rem; color: var(--color-text-muted); }
  .sample-steps > span i { display: grid; width: 1.6rem; height: 1.6rem; place-items: center; border: 1px solid var(--color-border-strong); border-radius: 50%; font-size: 0.72rem; font-style: normal; }
  .sample-steps .is-done i { color: var(--color-white); background: var(--color-builder-green); border-color: var(--color-builder-green); }
  .sample-steps .is-current { color: var(--color-scout-blue); font-weight: 600; }
  .sample-steps .is-current i { border: 2px solid var(--color-scout-blue); }

  .sample-avatars { display: flex; align-items: center; }
  .sample-avatars > span { display: grid; width: 2.2rem; height: 2.2rem; margin-right: -0.4rem; place-items: center; color: var(--color-scout-blue-strong); background: var(--color-scout-blue-soft); border: 2px solid var(--color-white); border-radius: 50%; font-size: 0.66rem; font-weight: 600; }
  .sample-avatars > span:nth-child(2) { color: var(--color-thinker-orange-strong); background: var(--color-thinker-orange-soft); }
  .sample-avatars > span:nth-child(3) { color: var(--color-builder-green-strong); background: var(--color-builder-green-soft); }
  .sample-avatars small { display: grid; width: 2rem; height: 2rem; margin-left: 0.5rem; place-items: center; background: var(--color-surface-muted); border-radius: 50%; }

  .sample-multiselect { display: flex; width: 100%; min-height: 2.5rem; flex-wrap: wrap; align-items: center; gap: 0.4rem; padding: 0.35rem; background: var(--color-white); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); }
  .sample-selected { display: flex; align-items: center; gap: 0.35rem; padding: 0.28rem 0.45rem; color: var(--color-scout-blue-strong); background: var(--color-scout-blue-soft); border-radius: 3px; font-size: 0.72rem; }
  .sample-selected b { font-size: 0.9rem; }
  .sample-multiselect > .sample-input-line { min-width: 8rem; flex: 1 1 8rem; border: 0; }

  .sample-scrollspy { display: grid; width: 100%; gap: 1rem; grid-template-columns: 9rem minmax(0, 1fr); }
  .sample-scrollspy nav { display: grid; align-content: start; gap: 0.45rem; padding-left: 0.55rem; border-left: 1px solid var(--color-border); font-size: 0.75rem; }
  .sample-scrollspy nav .is-current { margin-left: -0.62rem; padding-left: 0.55rem; border-left: 2px solid var(--color-scout-blue); color: var(--color-scout-blue); }
  .sample-scrollspy > div { display: grid; align-content: start; gap: 0.5rem; }
  .sample-scrollspy > div span { width: 90%; height: 0.35rem; background: var(--color-surface-muted); }

  .sample-alert-stack { display: grid; width: 100%; gap: 0.5rem; }
  .sample-alert { display: grid; gap: 0.1rem; padding: 0.55rem 0.7rem; border-left: 3px solid var(--color-info); background: var(--color-info-background); }
  .sample-alert b { font-size: 0.75rem; }
  .sample-alert span { color: var(--color-text-muted); font-size: 0.7rem; }
  .sample-alert-warn { border-color: var(--color-warning); background: var(--color-warning-background); }

  .sample-login { display: grid; width: min(100%, 20rem); gap: 0.35rem; }
  .sample-login > strong { margin-bottom: 0.25rem; font-size: 0.95rem; }
  .sample-login > span { margin-top: 0.2rem; font-size: 0.72rem; font-weight: 600; }
  .sample-login .sample-button { margin-top: 0.25rem; }
  .sample-login .sample-form-error { margin: 0; color: var(--color-auditor-red); font-size: 0.78rem; }
  .sample-login input[aria-invalid="true"] { border-color: var(--color-auditor-red); }

  .sample-pagination { display: flex; align-items: center; gap: 0.35rem; }
  .sample-pagination > span,
  .sample-pagination > b,
  .sample-pagination > button { display: grid; min-width: 2.2rem; min-height: 2.2rem; padding-inline: 0.4rem; place-items: center; border-radius: 3px; font-size: 0.9rem; }
  .sample-pagination > b,
  .sample-pagination > button[aria-current="page"] { color: var(--color-white); background: var(--color-scout-blue); }
  .sample-pagination .sample-page-arrow { width: auto; color: var(--color-text-muted); }
  .sample-pagination > button.sample-page-arrow { min-width: 0; color: var(--color-scout-blue); }

  .sample-calendar { width: 15rem; padding: 0.7rem; background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .sample-calendar header { display: flex; align-items: center; gap: 0.7rem; padding-bottom: 0.5rem; font-size: 0.72rem; }
  .sample-calendar header b { margin-right: auto; }
  .sample-calendar header span,
  .sample-calendar header button { display: grid; width: 2rem; height: 2rem; place-items: center; color: var(--color-scout-blue); border-radius: 3px; }
  .sample-calendar header button:hover { background: var(--color-scout-blue-soft); }
  .sample-calendar-grid { display: grid; text-align: center; gap: 0.18rem; grid-template-columns: repeat(7, 1fr); }
  .sample-calendar-grid > * { display: grid; min-height: 1.3rem; place-items: center; font-size: 0.68rem; }
  .sample-calendar-grid small { color: var(--color-text-muted); }
  .sample-calendar-grid button { min-height: 2rem; padding: 0; border-radius: 50%; font-size: 0.88rem; }
  .sample-calendar-grid button:hover { background: var(--color-scout-blue-soft); }
  .sample-calendar-grid .is-selected,
  .sample-calendar-grid button.is-selected { color: var(--color-white); background: var(--color-scout-blue); border-radius: var(--radius-sm); }

  .sample-parallax { display: grid; width: 100%; min-height: 15rem; align-content: center; gap: 0.55rem; }
  .sample-parallax-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.85rem; color: var(--color-text-muted); font-size: 0.7rem; }
  .sample-parallax-key { display: inline-flex; align-items: center; gap: 0.35rem; white-space: nowrap; }
  .sample-parallax-key::before { width: 0.5rem; height: 0.5rem; flex: 0 0 auto; background: var(--color-scout-blue); border-radius: 1px; content: ""; }
  .sample-parallax-key-back::before { background: var(--color-scout-blue); }
  .sample-parallax-key-middle::before { background: var(--color-builder-green); }
  .sample-parallax-key-front::before { background: var(--color-thinker-orange); }
  .sample-parallax-key b { color: var(--color-text); font-size: inherit; }
  .sample-parallax-viewport { height: 9.5rem; overflow: auto; overscroll-behavior: contain; background: var(--color-scout-blue-soft); border: 1px solid var(--color-scout-blue-border); border-radius: var(--radius-sm); scrollbar-color: var(--color-scout-blue-border) transparent; scrollbar-width: thin; }
  .sample-parallax-viewport:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .sample-parallax-track { position: relative; min-height: 27rem; isolation: isolate; overflow: clip; background: var(--color-scout-blue-soft); }
  .sample-parallax-layer { position: absolute; inset: 0; pointer-events: none; transform: translate3d(0, var(--parallax-offset-y, 0), 0); will-change: transform; }
  .sample-parallax-background { z-index: 0; }
  .sample-parallax-sun { position: absolute; top: 1.15rem; right: 16%; width: 1.4rem; aspect-ratio: 1; background: var(--color-thinker-orange); border-radius: 50%; }
  .sample-parallax-mountain { position: absolute; top: 3.1rem; right: -4%; left: -4%; height: 8rem; background: var(--color-scout-blue-border); clip-path: polygon(0 72%, 14% 42%, 27% 66%, 44% 24%, 58% 62%, 77% 35%, 100% 72%, 100% 100%, 0 100%); }
  .sample-parallax-middle { z-index: 1; }
