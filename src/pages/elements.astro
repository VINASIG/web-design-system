---
import DocsLayout from "../layouts/DocsLayout.astro";
import catalog from "../../docs/elements/catalog.json";
import specimens from "../../docs/elements/specimens.json";
import { withBaseAttributes } from "../lib/paths";

const platforms = ["Web", "macOS"] as const;
const entriesForPlatform = (platform: (typeof platforms)[number]) =>
  catalog.elements.filter((element) => element.platform === platform);
const slugify = (value: string) =>
  value.toLowerCase().replaceAll(" ", "-").replaceAll("&", "and");
---

<DocsLayout
  title="UI element library"
  description="A visual draft design system for all 81 interface entries, with styled examples and platform-aware guidance for web and macOS."
  eyebrow="Interface reference"
>
  <div class="rule-callout">
    <div>
      <strong>Visual examples for all 81 entries</strong>
      <p>Every example is shown at reading size. Interactive controls update within the sample, and the larger view gives you more room to inspect it. Definitions and guidance stay below.</p>
    </div>
  </div>

  <nav class="platform-index" aria-label="Catalog platforms">
    <a href="#web">Web entries <span>{entriesForPlatform("Web").length}</span></a>
    <a href="#macos">macOS entries <span>{entriesForPlatform("macOS").length}</span></a>
  </nav>

  <p class="catalog-note">The examples use the draft VINASIG palette, Space Grotesk, restrained surfaces, and shared spacing. Use web entries for website work. macOS samples are platform references. Their web adaptations are included only where the underlying need has a reasonable web equivalent.</p>

  {platforms.map((platform) => {
    const platformEntries = entriesForPlatform(platform);
    const platformId = platform === "Web" ? "web" : "macos";
    const platformCategories = catalog.categories.filter((category) => category.platform === platform);

    return (
      <section class="page-section catalog-platform" id={platformId} aria-labelledby={platformId + "-title"}>
        <div class="section-heading">
          <div>
            <p class="section-kicker">{platformEntries.length} entries</p>
            <h2 id={platformId + "-title"}>{platform === "Web" ? "Web interface patterns" : "macOS interface patterns"}</h2>
          </div>
          <p>{platform === "Web" ? "Use these entries to identify common website structures, controls, and states." : "Use these entries to recognize native macOS concepts. Do not reproduce desktop chrome in a website without a clear product need."}</p>
        </div>

        {platformCategories.map((category) => {
          const categoryEntries = platformEntries.filter((element) => element.category === category.name);
          const categoryId = platformId + "-" + slugify(category.name);

          return (
            <section class="element-category" aria-labelledby={categoryId + "-title"}>
              <div class="element-category-heading">
                <h3 id={categoryId + "-title"}>{category.name}</h3>
                <span>{categoryEntries.length}</span>
              </div>
              <div class="element-list">
                {categoryEntries.map((element) => {
                  const source = (specimens as Record<string, string>)[element.id];
                  const specimen = source && withBaseAttributes(source);

                  return (
                    <article class="element-entry" id={element.id}>
                      <header class="element-entry-heading">
                        <span class="element-order">{String(element.order).padStart(2, "0")}</span>
                        <span class="element-name">
                          <strong>{element.name}</strong>
                          <small>{element.id}</small>
                        </span>
                      </header>
                      <div class="element-preview" aria-label={element.name + " example"}>
                        <div class="ui-sample" data-specimen-id={element.id} set:html={specimen}></div>
                      </div>
                      <details class="element-notes">
                        <summary>Definition and implementation guidance</summary>
                        <div class="element-content">
                          <p>{element.definition}</p>
                        <div class="element-guidance">
                          <div>
                            <h4>Implementation guidance</h4>
                            <p>{element.guidance}</p>
                          </div>
                          <div>
                            <h4>Accessibility</h4>
                            <p>{element.accessibility}</p>
                          </div>
                          {element.webGuidance && (
                            <div class="web-adaptation">
                              <h4>Web adaptation</h4>
                              <p>{element.webGuidance}</p>
                            </div>
                          )}
                        </div>
                        </div>
                      </details>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </section>
    );
  })}
  <dialog class="element-demo-dialog" aria-labelledby="element-demo-title">
    <div class="element-demo-heading">
      <div>
        <p class="eyebrow">Interactive example</p>
        <h2 id="element-demo-title"></h2>
      </div>
      <button type="button" class="element-expand-button" data-close-demo>Close preview</button>
    </div>
    <p class="element-demo-description"></p>
    <div class="element-demo-stage"></div>
  </dialog>

  <script>
    import "../scripts/element-demos.ts";
  </script>

</DocsLayout>

<style is:global>
  .platform-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
    padding: 0.9rem 0;
    border-block: 1px solid var(--color-border);
  }

  .platform-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-small);
    font-weight: 600;
    text-decoration: none;
  }

  .platform-index span,
  .element-category-heading > span {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .catalog-note {
    max-width: 74ch;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .catalog-platform {
    scroll-margin-top: 1rem;
  }

  .element-category {
    margin-top: 1.5rem;
    scroll-margin-top: 1rem;
  }

  .element-category-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    margin-bottom: 0.4rem;
  }

  .element-category-heading h3 {
    margin: 0;
    font-size: var(--font-size-body);
  }

  .element-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .element-entry {
    min-width: 0;
    padding: 0.9rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .element-entry-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
  }

  .element-order {
    min-width: 1.8rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .element-name {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
    flex: 1;
  }

  .element-name strong {
    font-size: var(--font-size-body);
    font-weight: 600;
  }

  .element-expand-button {
    display: inline-flex;
    min-height: 2.25rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.65rem;
    color: var(--color-scout-blue-strong);
    background: var(--color-scout-blue-soft);
    border: 1px solid var(--color-scout-blue-border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--font-size-small);
    font-weight: 600;
    cursor: pointer;
  }

  .element-expand-button:hover {
    background: var(--color-scout-blue-border);
  }

  .element-name small {
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .element-preview {
    display: grid;
    min-height: 15rem;
    place-items: center;
    overflow: auto;
    color: var(--color-text);
    background: var(--color-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem;
  }

  .element-preview:has(.sample-context-demo) { min-height: 18rem; overflow: visible; }
  .element-preview .ui-sample:has(.sample-context-demo) { min-height: 15rem; align-items: center; overflow: visible; }

  .element-preview:has(.sample-hover) {
    min-height: 17rem;
    overflow: visible;
  }

  .element-preview:has(.sample-hover-card[data-state='open']) {
    min-height: 23.5rem;
    padding-bottom: 7.5rem;
  }

  .element-preview:has(.sample-combo-menu:not([hidden])) {
    min-height: 15rem;
    overflow: visible;
    align-items: start;
  }

  .element-preview .ui-sample:has(.sample-combo-menu:not([hidden])) {
    min-height: 13rem;
    align-content: start;
    padding-top: 0.5rem;
  }

  .element-preview:has(.sample-save-panel) { transition: min-height 180ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .element-preview:has(.sample-save-menu:not([hidden])) { min-height: 29rem; overflow: visible; place-items: start center; }
  .element-preview .ui-sample:has(.sample-save-panel) { transition: min-height 180ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .element-preview .ui-sample:has(.sample-save-menu:not([hidden])) { min-height: 27rem; align-content: start; padding-top: 0.5rem; }

  .element-preview .ui-sample:has(.sample-hover) {
    min-height: 15rem;
  }

  .element-preview .ui-sample {
    width: 100%;
    max-width: 44rem;
    min-height: 12rem;
  }

  .element-preview:has(.sample-search-demo) { transition: min-height 170ms cubic-bezier(0.2, 0.75, 0.25, 1); }
  .element-preview:has(.sample-search-recents:not([hidden])) { min-height: 20rem; place-items: start center; overflow: visible; }
  .element-preview .ui-sample:has(.sample-search-recents:not([hidden])) { min-height: 18rem; align-items: flex-start; padding-top: 0.5rem; overflow: visible; }

  .element-preview .ui-sample > * {
    max-width: 100%;
  }

  .element-preview:has(.sample-bottom-nav-demo) { place-items: start center; }
  .element-preview .ui-sample:has(.sample-bottom-nav-demo) { align-items: flex-start; }

  .element-notes {
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .element-notes > summary {
    padding: 0.65rem 0 0.1rem;
    color: var(--color-scout-blue-strong);
    font-size: var(--font-size-small);
    font-weight: 600;
    cursor: pointer;
  }

  .element-notes > summary:focus-visible,
  .element-expand-button:focus-visible,
  .ui-sample button:focus-visible,
  .ui-sample input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .element-content {
    padding: 0.65rem 0.1rem 0.35rem;
  }

  .element-demo-dialog {
    width: min(58rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100vh - 2rem);
    padding: 1.25rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: 0 1.25rem 4rem rgb(68 58 59 / 24%);
  }

  .element-demo-dialog[data-anchor-top="true"] {
    position: fixed;
    top: min(var(--demo-dialog-anchor-top), calc(100vh - 3rem));
    top: min(var(--demo-dialog-anchor-top), calc(100dvh - 3rem));
    right: auto;
    bottom: auto;
    left: 50%;
    max-height: calc(100vh - min(var(--demo-dialog-anchor-top), calc(100vh - 3rem)) - 1rem);
    max-height: calc(100dvh - min(var(--demo-dialog-anchor-top), calc(100dvh - 3rem)) - 1rem);
    margin: 0;
    overflow: auto;
    overscroll-behavior: contain;
    transform: translateX(-50%);
  }

  .element-demo-dialog::backdrop {
    background: rgb(31 27 28 / 62%);
  }

  .element-demo-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .element-demo-heading .eyebrow {
    margin-bottom: 0.25rem;
  }

  .element-demo-heading h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .element-demo-description {
    max-width: 70ch;
    color: var(--color-text-muted);
  }

  .element-demo-stage {
    display: grid;
    min-height: 18rem;
    place-items: center;
    padding: 1.25rem;
    background: var(--color-canvas);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .element-demo-stage:has(.sample-bottom-nav-demo) { place-items: start center; }
  .element-demo-stage .ui-sample:has(.sample-bottom-nav-demo) { min-height: 0; align-items: flex-start; }

  .element-demo-stage:has(.sample-menu-bar-demo) {
    min-height: 23rem;
    place-items: start center;
    overflow: visible;
  }

  .element-demo-stage:has(.sample-context-demo) { min-height: 22rem; overflow: visible; }
  .element-demo-stage .ui-sample:has(.sample-context-demo) { max-width: 44rem; min-height: 19rem; align-items: center; overflow: visible; }

  .element-demo-stage .ui-sample:has(.sample-menu-bar-demo) {
    max-width: 54rem;
    min-height: 18rem;
    align-items: flex-start;
    padding-top: 2.5rem;
    overflow: visible;
  }

  .element-demo-stage:has(.sample-multi-select-showcase) { min-height: 29rem; }
  .element-demo-stage:has(.sample-multi-select-showcase) .ui-sample { max-width: 54rem; min-height: 25rem; }

  .element-demo-stage:has(.sample-hover) {
    min-height: 25rem;
  }

  .element-demo-stage .ui-sample:has(.sample-hover) {
    max-width: 34rem;
    min-height: 19rem;
  }

  .element-demo-stage:has(.sample-control-trio) {
    min-height: 22rem;
  }

  .element-preview:has(.sample-popup-comparison) { min-height: 18rem; overflow: visible; container-type: inline-size; }
  .element-preview .ui-sample:has(.sample-popup-comparison) { min-height: 16rem; overflow: visible; }
  .element-demo-stage:has(.sample-popup-comparison) { min-height: 25rem; overflow: visible; container-type: inline-size; }
  .element-demo-stage .ui-sample:has(.sample-popup-comparison) { max-width: 56rem; min-height: 22rem; overflow: visible; }

  .element-demo-stage:has(.sample-save-panel) { min-height: 25rem; }
  .element-demo-stage .ui-sample:has(.sample-save-panel) { max-width: 42rem; min-height: 23rem; }
  .element-demo-stage:has(.sample-save-panel) { transition: min-height 180ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .element-demo-stage:has(.sample-save-menu:not([hidden])) { min-height: 29rem; overflow: visible; }
  .element-demo-stage .ui-sample:has(.sample-save-panel) { transition: min-height 180ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .element-demo-stage .ui-sample:has(.sample-save-menu:not([hidden])) { min-height: 27rem; align-content: start; padding-top: 0.5rem; }

  .element-demo-stage .ui-sample {
    width: 100%;
    max-width: 48rem;
    min-height: 15rem;
    font-size: 1.05rem;
  }

  .element-demo-stage:has(.sample-search-demo) { transition: min-height 170ms cubic-bezier(0.2, 0.75, 0.25, 1); }
  .element-demo-stage:has(.sample-search-recents:not([hidden])) { min-height: 22rem; place-items: start center; overflow: visible; }
  .element-demo-stage .ui-sample:has(.sample-search-recents:not([hidden])) { min-height: 20rem; align-items: flex-start; padding-top: 0.5rem; overflow: visible; }

  .element-demo-stage .ui-sample:has(.sample-parallax) {
    max-width: 40rem;
  }

  .element-demo-stage .sample-parallax-viewport {
    height: 13rem;
    --parallax-scroll-distance: calc(100% - 13rem + 2px);
  }

  .element-demo-stage .ui-sample small {
    font-size: 0.82rem;
  }

  .ui-sample,
  .ui-sample * {
    box-sizing: border-box;
    font-family: "Space Grotesk", sans-serif;
  }

  .ui-sample {
    display: flex;
    width: 100%;
    min-width: 0;
    min-height: 12rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  :where(.ui-sample) button {
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
    text-align: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .ui-sample input {
    min-width: 0;
    color: inherit;
    font: inherit;
  }

  .ui-sample strong,
  .ui-sample b {
    font-weight: 600;
  }

  .ui-sample small {
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .ui-sample .ui-icon {
    color: var(--color-scout-blue);
    width: 0.95rem;
    height: 0.95rem;
  }

  .sample-button {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.7rem;
    color: var(--color-white);
    background: var(--color-scout-blue);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .sample-button-small {
    min-height: 1.8rem;
    padding-inline: 0.55rem;
  }

  .sample-input-line {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.55rem;
    color: var(--color-text-muted);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .sample-state {
    width: fit-content;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.82rem;
  }

  .sample-state-green {
    color: var(--color-builder-green-strong);
    background: var(--color-builder-green-soft);
  }

  .sample-state-orange {
    color: var(--color-thinker-orange-strong);
    background: var(--color-thinker-orange-soft);
  }

  .sample-state-red {
    color: var(--color-auditor-red);
    background: var(--color-auditor-red-soft);
  }

  .sample-card-blue { background: var(--color-scout-blue-soft); }
  .sample-card-orange { background: var(--color-thinker-orange-soft); }
  .sample-card-green { background: var(--color-builder-green-soft); }
  .sample-card-red { background: var(--color-auditor-red-soft); }

  .sample-data-table { container-type: inline-size; width: 100%; overflow: hidden; background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .sample-data-table-scroll { width: 100%; overflow-x: auto; }
  .sample-data-table table { width: max(100%, var(--sample-table-width, 100%)); min-width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 0.72rem; text-align: left; }
  .sample-data-table th,
  .sample-data-table td { padding: 0.5rem 0.65rem; border-bottom: 1px solid var(--color-border); white-space: nowrap; }
  .sample-data-table th { position: relative; padding: 0.5rem 0.65rem; border-bottom: 1px solid var(--color-border); white-space: nowrap; }
  .sample-data-table th { color: var(--color-text-muted); background: var(--color-surface-muted); font-weight: 600; }
  .sample-data-table th.sample-data-select,
  .sample-data-table td:first-child { padding-inline: 0.65rem 0.2rem; }
  .sample-data-table th[data-sort-column] button { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 0.4rem; padding: 0; color: inherit; background: transparent; border: 0; font: inherit; text-align: left; cursor: pointer; }
  .sample-data-table .sample-sort-icon { width: 0.9rem; height: 0.9rem; color: var(--color-text-muted); }
  .sample-data-table th[aria-sort] .sample-sort-icon { color: var(--color-scout-blue); }
  .sample-data-table th[data-sort-column] button:hover { color: var(--color-scout-blue); }
  .sample-table-resize-handle { position: absolute; z-index: 2; inset-block: 0; right: -0.45rem; display: grid; width: 0.9rem; place-items: center; color: var(--color-text-muted); border-radius: 3px; cursor: col-resize; touch-action: none; }
  .sample-table-resize-handle::after { width: 4px; height: 1.1rem; border-inline: 1px solid currentColor; content: ""; opacity: 0.4; transition: opacity 120ms ease, color 120ms ease; }
  .sample-table-resize-handle:hover,
  .sample-table-resize-handle:focus-visible { color: var(--color-scout-blue); background: var(--color-scout-blue-soft); outline: 2px solid var(--color-scout-blue); outline-offset: -2px; }
  .sample-table-resize-handle:hover::after,
  .sample-table-resize-handle:focus-visible::after { opacity: 1; }
  .sample-data-table tbody tr:nth-child(even) { background: var(--color-surface); }
  .sample-data-table tbody tr:hover { background: var(--color-surface-muted); }
  .sample-data-table tbody tr.is-selected,
  .sample-data-table tbody tr.is-selected:hover { background: var(--color-scout-blue-soft); }
  .sample-data-table tbody tr.is-entering > td { animation: sample-data-table-row-enter 190ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: var(--table-row-delay, 0ms); }
  @keyframes sample-data-table-row-enter { from { opacity: 0.35; } to { opacity: 1; } }
  .sample-data-table td:last-child,
  .sample-data-table th:last-child { text-align: right; }
  .sample-data-table th:last-child,
  .sample-data-table td:last-child { padding-inline: 0.55rem; }
  .sample-data-table td:last-child { font-variant-numeric: tabular-nums; font-weight: 600; }
  .sample-data-table input[type="checkbox"] { width: 0.9rem; height: 0.9rem; margin: 0; accent-color: var(--color-scout-blue); vertical-align: middle; cursor: pointer; }
  .sample-data-table-footer { display: flex; min-height: 2.3rem; align-items: center; justify-content: space-between; gap: 0.65rem; padding: 0.35rem 0.65rem; color: var(--color-text-muted); background: var(--color-white); font-size: 0.66rem; }
  .sample-data-table-footer > *,
  .sample-data-table-pages > * { white-space: nowrap; }
  .sample-data-table-footer [data-table-selection] { color: var(--color-scout-blue-strong); font-weight: 600; }
  .sample-data-table-pages { display: flex; align-items: center; gap: 0.4rem; }
  .sample-data-table-pages button { min-height: 2rem; padding: 0.15rem 0.45rem; color: var(--color-scout-blue); background: var(--color-white); border: 1px solid var(--color-border); border-radius: 3px; font: inherit; cursor: pointer; }
  .sample-data-table-pages button:hover:not(:disabled) { background: var(--color-scout-blue-soft); }
  .sample-data-table-pages button:disabled { color: var(--color-text-muted); opacity: 0.5; cursor: default; }
  @media (prefers-reduced-motion: reduce) { .sample-data-table tbody tr.is-entering > td { animation: none; } }

  @container (max-width: 40rem) {
    .sample-data-table-footer { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "selection range" "pages pages"; gap: 0.4rem 0.65rem; padding-block: 0.5rem; }
