  .element-content > p,
  .element-guidance p {
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
  }

  .element-guidance {
    display: grid;
    gap: 0.85rem 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .element-guidance h4 {
    margin-bottom: 0.2rem;
    color: var(--color-text);
    font-size: var(--font-size-small);
    letter-spacing: 0;
  }

  .element-guidance p {
    margin-bottom: 0;
    font-size: var(--font-size-small);
  }

  .web-adaptation {
    grid-column: 1 / -1;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 820px) {
    .element-entry {
      padding: 0.85rem;
    }

    .element-preview {
      min-height: 14rem;
      padding: 0.85rem;
    }

    .sample-data-table th,
    .sample-data-table td {
      padding-inline: 0.45rem;
    }

    .sample-scrollspy {
      gap: 0.75rem;
      grid-template-columns: minmax(7rem, 9rem) minmax(0, 1fr);
    }

    .sample-calendar,
    .sample-navigation-demo,
    .sample-focus-macos,
    .sample-lightbox,
    .sample-overflow,
    .sample-outline {
      width: 100%;
    }

    .sample-motion-chart {
      width: 100%;
      max-width: 12rem;
    }

    .sample-cursor {
      width: 100%;
      min-width: 0;
    }

    .sample-positioning {
      flex-wrap: wrap;
      justify-content: stretch;
    }

    .sample-positioning > div {
      min-width: 0;
      flex: 1 1 7rem;
    }

    .sample-progress-set,
    .sample-loading,
    .sample-control-trio,
    .sample-site-header {
      flex-wrap: wrap;
    }

    .sample-progress-set,
    .sample-loading {
      justify-content: flex-start;
    }

    .sample-control-trio > div {
      flex: 1 1 4rem;
    }

    .sample-menu-bar { grid-template-columns: minmax(0, 1fr); }
    .sample-menu-bar-leading { flex-wrap: wrap; }
    .sample-menu-bar-app-menus { flex-wrap: wrap; }
    .sample-menu-bar-status { justify-self: end; }

    .sample-tabs-list { gap: 0.5rem; }
    .sample-label-comparison { grid-template-columns: repeat(auto-fit, minmax(min(100%, max(9rem, calc((100% - 0.45rem) / 2))), 1fr)); gap: 0.45rem; }
    .sample-label-card { min-height: 6.9rem; padding-inline: 0.35rem; }

    .element-guidance {
      grid-template-columns: minmax(0, 1fr);
    }

    .web-adaptation {
      grid-column: auto;
    }

    .element-entry-heading {
      flex-wrap: wrap;
    }

    .element-name {
      flex: 1 1 12rem;
    }

    .element-expand-button {
      margin-left: auto;
    }
  }

  @media (max-width: 420px) {
    .sample-login { gap: 0.5rem; padding: 0.9rem; }
    .sample-login-provider { min-height: 2.4rem; font-size: 0.76rem !important; }
    .sample-login-input { min-height: 2.45rem; }
    .element-demo-dialog:has(.sample-login) { width: calc(100vw - 1rem); max-height: calc(100vh - 1rem); padding: 0.8rem; }
    .element-demo-stage:has(.sample-login) { min-height: 24rem; padding: 0.65rem; }
    .sample-truncation { gap: 0.6rem; }
    .sample-truncation-toolbar { gap: 0.45rem; }
    .sample-truncation-width-label { flex-basis: 100%; }
    .sample-truncation-expand { margin-left: 0 !important; }
    .sample-truncation-card { padding-inline: 0.75rem; }
    .sample-truncation-example { padding-block: 0.65rem; }
    .sample-chat-header { gap: 0.5rem; padding: 0.7rem 0.75rem; }
