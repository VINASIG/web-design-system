---
import {
  Bot,
  Check,
  ChevronDown,
  ExternalLink,
  Grid2x2,
  House,
  Sun,
  Moon,
  Info,
  Layers,
  ListTodo,
  Palette,
  Shapes,
  TriangleAlert,
} from "@lucide/astro";
import type { UIIconName } from "../scripts/icon-names";

const iconComponents = {
  home: House,
  sun: Sun,
  moon: Moon,
  agents: Bot,
  brand: Palette,
  foundations: Layers,
  components: Grid2x2,
  patterns: Shapes,
  elements: ListTodo,
  info: Info,
  check: Check,
  error: TriangleAlert,
  chevronDown: ChevronDown,
  externalLink: ExternalLink,
} satisfies Record<UIIconName, typeof House>;

const { name, class: className = "", size = 24 } = Astro.props as {
  name: UIIconName;
  class?: string;
  size?: number;
};

const IconComponent = iconComponents[name];

if (!IconComponent) {
  throw new Error(`Unknown icon name: ${name}`);
}
---

<IconComponent size={size} class:list={["ui-icon", `ui-icon--${name}`, className]} aria-hidden="true" focusable="false" />
