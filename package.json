{
  "name": "@vinasig/web-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draft interface guidance, design tokens and UI specimens for VINASIG websites and SI agents.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VINASIG/web-design-system.git"
  },
  "homepage": "https://vinasig.github.io/web-design-system/",
  "bugs": {
    "url": "https://github.com/VINASIG/web-design-system/issues"
  },
  "keywords": [
    "vinasig",
    "design-system",
    "astro",
    "si-agents",
    "accessibility"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "check:content": "node scripts/check-content.mjs",
    "check:standards": "node scripts/check-standards.mjs",
    "check:scripts": "node --check scripts/check-content.mjs && node --check scripts/check-standards.mjs && node --check tests/standards.test.mjs && node --check tests/helpers/preview.mjs && node --check tests/helpers/screenshot.mjs && node --check tests/responsive.mjs",
    "check": "npm run check:standards && npm run check:content && npm run check:scripts && astro check && npm run check:licenses",
    "test:standards": "node --test tests/standards.test.mjs",
    "test": "npm run test:responsive",
    "test:responsive": "node tests/responsive.mjs",
    "build": "astro build && npm run check:licenses -- --built",
    "preview": "astro preview",
    "deploy": "gh workflow run check.yml --ref main",
    "deploy:cloudflare": "npm run build -- --base / && wrangler deploy",
    "check:licenses": "node .vinasig/standards/templates/check-licenses.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "astro": "7.3.5",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "@lucide/astro": "1.50.0",
    "lucide": "1.50.0",
    "simple-icons": "16.33.0"
  }
}
