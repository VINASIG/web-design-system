{
  "name": "vinasig-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "check:content": "node scripts/check-content.mjs",
    "check:scripts": "node --check scripts/check-content.mjs && node --check tests/helpers/preview.mjs && node --check tests/responsive.mjs",
    "check": "npm run check:content && npm run check:scripts && astro check",
    "test": "npm run test:responsive",
    "test:responsive": "node tests/responsive.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.5",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "wrangler": "4.146.0"
  },
  "dependencies": {
    "@lucide/astro": "^1.48.0",
    "lucide": "^1.48.0",
    "simple-icons": "^16.33.0"
  }
}
