  "timeline": "<div class='sample-timeline'><header class='sample-timeline-header'><div class='sample-timeline-heading'><strong>Order #4821</strong><small>Order tracking</small></div><span class='sample-timeline-status' data-timeline-status>Out for delivery</span></header><ol class='sample-timeline-list' aria-label='Order #4821 tracking timeline'><li class='sample-timeline-item is-complete'><time class='sample-timeline-time' datetime='2026-09-28T09:12:00+07:00'>09:12</time><span class='sample-timeline-marker' aria-hidden='true'><span class='sample-timeline-dot'></span></span><div class='sample-timeline-event'><strong>Order placed</strong><small>3 items</small></div></li><li class='sample-timeline-item is-complete'><time class='sample-timeline-time' datetime='2026-09-28T09:13:00+07:00'>09:13</time><span class='sample-timeline-marker' aria-hidden='true'><span class='sample-timeline-dot'></span></span><div class='sample-timeline-event'><strong>Payment confirmed</strong><small>Visa ending 4242</small></div></li><li class='sample-timeline-item is-complete'><time class='sample-timeline-time' datetime='2026-09-28T14:40:00+07:00'>14:40</time><span class='sample-timeline-marker' aria-hidden='true'><span class='sample-timeline-dot'></span></span><div class='sample-timeline-event'><strong>Shipped</strong><small>Left the warehouse</small></div></li><li class='sample-timeline-item is-current'><time class='sample-timeline-time' datetime='2026-09-28'>Today</time><span class='sample-timeline-marker'><button class='sample-timeline-dot-button' type='button' data-action='timeline-complete' aria-label='Mark order #4821 as delivered'></button></span><div class='sample-timeline-event'><strong data-timeline-title>Out for delivery</strong><small data-timeline-detail>Arriving by 6 pm</small></div></li></ol><p class='sample-timeline-hint'>Select the open marker to finish delivery.</p></div>",
  "status-dot": "<div class='sample-status' data-presence-state='available'><div class='sample-presence-card'><header class='sample-presence-header'><span class='sample-presence-live'><span class='sample-presence-live-dot' aria-hidden='true'></span><span data-presence-live>Live now</span></span><span>Design standup</span></header><div class='sample-presence-person'><span class='sample-presence-avatar' aria-hidden='true'>AR<span class='sample-presence-avatar-indicator'><span></span></span></span><span class='sample-presence-identity'><strong>Ava Reyes</strong><span data-presence-label>Available</span><small data-presence-meta>Last active now</small></span></div><fieldset class='sample-presence-fieldset'><legend>Set presence</legend><div class='sample-presence-options'><button class='sample-presence-option' type='button' data-action='presence-set' data-status='available' aria-pressed='true'><span class='sample-presence-option-dot' aria-hidden='true'></span><span>Available</span></button><button class='sample-presence-option' type='button' data-action='presence-set' data-status='away' aria-pressed='false'><span class='sample-presence-option-dot' aria-hidden='true'></span><span>Away</span></button><button class='sample-presence-option' type='button' data-action='presence-set' data-status='busy' aria-pressed='false'><span class='sample-presence-option-dot' aria-hidden='true'></span><span>Busy</span></button><button class='sample-presence-option' type='button' data-action='presence-set' data-status='offline' aria-pressed='false'><span class='sample-presence-option-dot' aria-hidden='true'></span><span>Offline</span></button></div></fieldset><p class='sample-presence-feedback' data-presence-feedback aria-live='polite'>Choose a status to preview presence.</p></div></div>",
